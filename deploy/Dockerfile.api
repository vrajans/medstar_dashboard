# FastAPI backend → Cloud Run. Build context = repo root (needs api/, ai/,
# payment_integrity.py, warehouse.py, etc.).
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

ENV PORT=8080
# Cloud Run sets $PORT; uvicorn must bind to it.
CMD exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --workers 1
